{
  "name": "daevu",
  "version": "2.0.8",
  "private": true,
  "description": "A calm place for projects, notes, canvas and calendar, with optional AI helpers",
  "author": "Daevu",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "test:web-chat": "node scripts/test-web-chat.cjs",
    "test:ui": "node scripts/test-ui-smoke.cjs",
    "test:welcome": "node scripts/test-onboarding.cjs",
    "check:docs": "node scripts/check-docs.cjs"
  },
  "dependencies": {
    "@automerge/automerge": "^3.5.0",
    "@chenglou/pretext": "^1.0.0",
    "@e965/xlsx": "^0.20.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xyflow/react": "^12.9.0",
    "cross-spawn": "^7.0.6",
    "dompurify": "^3.4.17",
    "esbuild": "0.28.2",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "motion": "^14.4.0",
    "parse5": "8.0.1",
    "pdfjs-dist": "^6.4.299",
    "phaser": "4.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-icons": "^16.35.0",
    "smol-toml": "^1.9.1",
    "three": "0.186.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.7",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "dev.researchworkspace.desktop",
    "productName": "Daevu",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "bundled-plugins/**/*",
      "electron/**/*",
      "shared/**/*",
      "build/icon.png",
      "build/INTER-LICENSE.txt",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "TRADEMARKS.md"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh",
      "uninstallDisplayName": "Daevu",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Daevu-${version}-${arch}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Daevu-${version}-${arch}-Portable.${ext}"
    },
    "asarUnpack": [
      "node_modules/@esbuild/**/*",
      "node_modules/esbuild/**/*"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
